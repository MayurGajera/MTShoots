# ==============================================================================
# MTShoots — Next.js Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# ==============================================================================

# Supabase Public Keys (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Database Direct Connection (Supabase PostgreSQL Pooler)
DATABASE_URL="postgresql://postgres.[PROJECT-ID]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-ID]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MTShoots

# Storage Bucket for Photographer Portfolios & Avatars
IMAGE_STORAGE_BUCKET=mtshoots-portfolios
